        "visible": false,
        "enabled": false,
        "children_drop": [
          {
            "label1": " "
          }
        ]
      },
      {
        "id": "fileFormat",
        "label": "File format: ",
        "toolTip": "Choose output file format for saved still images. JPEG: Compressed format ideal for photos and web use. PNG: Lossless compression with transparency support. RAW: Uncompressed raw sensor data for maximum quality and post-processing flexibility. BMP: Uncompressed bitmap format for compatibility with legacy systems. All formats are cross-platform compatible.",
        "value": "dropBox",
        "visible": true,
        "enabled": true,
        "children_drop": [
          {
            "label1": "BMP"
          },
          {
            "label1": "RAW"
          },
          {
            "label1": "PNG"
          },
          {
            "label1": "JPEG"
          }
        ]
